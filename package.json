{
  "name": "steerloop",
  "version": "0.3.0",
  "description": "Two agent skills that keep a coding agent on one slice: ask before coding, red-first tests, stop gates, honest reports — plus a commit gate that enforces the report.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukavtz/steerloop.git"
  },
  "homepage": "https://github.com/lukavtz/steerloop",
  "keywords": [
    "agent-skills",
    "skills",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode",
    "prompt-engineering",
    "commit-hook"
  ],
  "bin": {
    "steerloop-gate": "./gate/steerloop-gate.mjs"
  },
  "scripts": {
    "test": "node --test gate/steerloop-gate.test.mjs && node scripts/validate-skills.mjs",
    "gate:install": "git config core.hooksPath .githooks",
    "gate:check": "node gate/steerloop-gate.mjs --body-file",
    "validate": "node scripts/validate-skills.mjs"
  },
  "files": [
    "skills",
    "gate",
    "scripts",
    ".githooks",
    "stack.json",
    "THIRD_PARTY_NOTICE.md",
    "THIRD_PARTY_LICENSES",
    "README.md",
    "LICENSE"
  ]
}
